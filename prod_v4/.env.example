# LCMS Reviewer v4 production environment for 10.117.1.148:4444
SERVER_IP=10.117.1.148
SERVER_PORT=4444
APP_BASE_URL=http://10.117.1.148:4444
TZ=UTC
COMPOSE_PROJECT_NAME=lcms-reviewer

# Flask / app
LCMS_SECRET_KEY=replace-with-a-long-random-secret
LCMS_MAX_CONTENT_MB=64
LCMS_SECURE_COOKIES=false
LCMS_DATA_DIR=/data

# Gunicorn
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5

# PostgreSQL
POSTGRES_DB=lcms_reviewer
POSTGRES_USER=lcms
POSTGRES_PASSWORD=replace-with-a-strong-db-password
DATABASE_URL=postgresql+psycopg://lcms:replace-with-a-strong-db-password@db:5432/lcms_reviewer

# Backups
BACKUP_DIR=/opt/lcms-reviewer/backups
BACKUP_RETENTION_DAYS=14
