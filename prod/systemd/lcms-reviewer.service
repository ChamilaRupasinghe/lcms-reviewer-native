[Unit]
Description=LCMS Reviewer Docker Compose Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/lcms-reviewer/reviewer_app/prod
RemainAfterExit=yes
ExecStart=/usr/bin/docker compose --env-file .env -f docker-compose.prod.yml up -d --build
ExecStop=/usr/bin/docker compose --env-file .env -f docker-compose.prod.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
