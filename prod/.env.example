# App
LCMS_SECRET_KEY=change-this-secret
LCMS_MAX_CONTENT_MB=64
LCMS_SECURE_COOKIES=false

# Gunicorn
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
