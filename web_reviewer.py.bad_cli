    run_id: Mapped[int] = mapped_column(ForeignKey("review_runs.id"), nullable=False, index=True)
    accession: Mapped[str] = mapped_column(String(80), index=True, nullable=False)
    instrument: Mapped[str] = mapped_column(String(120), default="", nullable=False)
    source_file: Mapped[str] = mapped_column(String(255), default="", nullable=False)
    well_position: Mapped[str] = mapped_column(String(32), default="", nullable=False)
    batch_name: Mapped[str] = mapped_column(String(255), default="", nullable=False)
    run_date_text: Mapped[str] = mapped_column(String(80), default="", nullable=False)
    flag_count: Mapped[int] = mapped_column(Integer, default=0, nullable=False)
    highest_severity: Mapped[str] = mapped_column(String(20), default="", nullable=False)
    positive_analytes: Mapped[str] = mapped_column(Text, default="", nullable=False)

    run: Mapped[ReviewRun] = relationship(back_populates="specimens")
    analytes: Mapped[List["AnalyteResult"]] = relationship(back_populates="specimen", cascade="all, delete-orphan")
    flags: Mapped[List["Flag"]] = relationship(back_populates="specimen", cascade="all, delete-orphan")


